export function createInAnimation(refs: {{pascalCase name}}Refs): gsap.core.Animation | undefined {
  const [isValid, validatedRefs] = validateAndUnwrapRefs(refs);
  if (!isValid) {
    return undefined;
  }
  const { self } = validatedRefs;

  const timeline = gsap.timeline();

  timeline.add(fadeFromTo(self, { duration: 0.01 }));

  return timeline;
};

