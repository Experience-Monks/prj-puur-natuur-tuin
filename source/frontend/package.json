{
  "name": "puur-natuur-tuin",
  "version": "0.0.0",
  "license": "MIT",
  "author": "frontend.monks",
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.js",
    "dev:https": "node scripts/server.js --https",
    "build": "next build",
    "start": "next start",
    "export": "node scripts/export.js",
    "test": "jest",
    "typecheck": "tsc --project tsconfig.json --noEmit --noUnusedLocals",
    "plop": "pota plop && npm run format",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:stylelint": "npm run lint:stylelint -- --fix",
    "fix": "run-s fix:* && npm run format",
    "format": "prettier . --write --log-level warn",
    "lint:eslint": "next lint --cache-location node_modules/.cache/.eslintcache",
    "lint:stylelint": "stylelint ./**/*.scss --cache --cache-location node_modules/.cache/.stylelintcache",
    "lint": "run-s lint:*",
    "rsync": "rsync -avPx out/* ${npm_package_name}@${npm_package_config_host}:~/public/ --delete",
    "storybook": "storybook dev -p 9001",
    "build:storybook": "storybook build",
    "postinstall": "patch-package && npm rebuild fsevents optipng-bin mozjpeg node-sass esbuild && cd node_modules/esbuild && npm i && npm run postinstall && cd ../../../../ && husky source/frontend/.husky",
    "preview:storybook": "npx serve storybook-static",
    "preview:export": "npx serve out",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch"
  },
  "config": {
    "host": "eu.dev.monkapps.com"
  },
  "browserslist": [
    "last 2 versions",
    "not ie <= 11, not ie_mob <= 11",
    "not dead"
  ],
  "prettier": "@mediamonks/prettier-config",
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@mediamonks/channels": "^1.0.3",
    "@mediamonks/react-kit": "^2.0.4",
    "@mediamonks/scss-utils": "^4.0.0",
    "@mediamonks/task-loader": "^0.2.1",
    "@next/bundle-analyzer": "^13.0.0",
    "@psimk/typed-object": "^1.0.4",
    "@rive-app/canvas": "^2.7.4",
    "@rive-app/react-canvas": "^4.5.4",
    "@types/lodash-es": "^4.17.6",
    "@types/rimraf": "^3.0.2",
    "@types/selfsigned": "^2.0.0",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "gsap": "npm:@gsap/business@^3.12.2",
    "i18next": "^23.16.4",
    "install": "^0.13.0",
    "isntnt": "^1.5.2",
    "lodash-es": "^4.17.21",
    "minimist": "^1.2.7",
    "next": "^15.0.3",
    "next-transpile-modules": "^10.0.0",
    "node-fetch": "^3.3.2",
    "normalize.css": "^8.0.1",
    "npm": "^10.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-use": "^17.5.1",
    "recoil": "^0.7.5",
    "rimraf": "^4.0.0",
    "sample-manager": "^2.1.4",
    "selfsigned": "^2.0.1",
    "seng-device-state-tracker": "^1.1.4",
    "seng-disposable": "^1.1.3",
    "seng-disposable-event-listener": "^2.0.1",
    "seng-disposable-manager": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.2",
    "@commitlint/cli": "^18.0.0",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/client-preset": "^4.8.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.0",
    "@mediamonks/commitlint-config": "^1.0.1",
    "@mediamonks/commitlint-issue-reference": "^1.1.0",
    "@mediamonks/eslint-config": "^2.0.6",
    "@mediamonks/eslint-config-react": "^2.1.9",
    "@mediamonks/eslint-config-typescript": "^1.0.8",
    "@mediamonks/eslint-config-typescript-react": "^1.0.10",
    "@mediamonks/prettier-config": "^1.0.0",
    "@mediamonks/stylelint-config-scss": "^1.0.9",
    "@next/eslint-plugin-next": "^13.0.0",
    "@pota/cli": "^2.0.1",
    "@pota/plop-scripts": "^1.0.0-rc.1",
    "@storybook/addon-essentials": "^8.4.4",
    "@storybook/addon-interactions": "^8.4.4",
    "@storybook/addon-links": "^8.4.4",
    "@storybook/addons": "^7.6.17",
    "@storybook/components": "^8.4.4",
    "@storybook/nextjs": "^8.4.4",
    "@storybook/react": "^8.4.4",
    "@storybook/test": "^8.4.4",
    "@storybook/theming": "^8.4.4",
    "@svgr/webpack": "^8.0.0",
    "@types/detect-port": "^1.3.2",
    "@types/minimist": "^1.2.2",
    "@types/node": "^20.16.11",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.5",
    "cross-env": "^7.0.3",
    "detect-port": "^1.6.1",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^15.2.10",
    "node-sass-json-importer": "^4.3.0",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "plop": "^4.0.0",
    "prettier": "^3.3.3",
    "sass": "^1.80.4",
    "storybook": "^8.4.4",
    "typescript": "^5.0.0",
    "webpack": "^5.95.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "gsap": "$gsap"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10",
    "yarn": "unsupported"
  },
  "pota": "@pota/plop-scripts",
  "commitlint": {
    "extends": [
      "@mediamonks/commitlint-config"
    ]
  },
  "commitlintIssueReference": {
    "location": "header",
    "autoAdd": true,
    "issuePrefix": "",
    "issueCommitPattern": "^(?<issue>[A-Z\\d]+-\\d+) ",
    "issueBranchPattern": "(?:^|/)(?<issue>[A-Z\\d]+-\\d+)-"
  },
  "stylelint": {
    "extends": "@mediamonks/stylelint-config-scss"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@next/next/core-web-vitals"
    ],
    "env": {
      "browser": true,
      "node": true
    },
    "overrides": [
      {
        "files": [
          "*.js",
          "*.jsx"
        ],
        "parserOptions": {
          "ecmaVersion": "latest"
        },
        "extends": [
          "@mediamonks/eslint-config",
          "@mediamonks/eslint-config-react"
        ]
      },
      {
        "files": [
          "*.ts",
          "*.tsx"
        ],
        "parserOptions": {
          "project": "./tsconfig.eslint.json"
        },
        "extends": [
          "@mediamonks/eslint-config",
          "@mediamonks/eslint-config-react",
          "@mediamonks/eslint-config-typescript",
          "@mediamonks/eslint-config-typescript-react"
        ]
      },
      {
        "files": [
          "*.tsx",
          "*.jsx"
        ],
        "rules": {
          "react/jsx-no-literals": 0
        }
      }
    ]
  }
}
