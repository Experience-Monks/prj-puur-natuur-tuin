NEXT_PUBLIC_DEBUG_WEB_VITALS=true
RECOIL_DUPLICATE_ATOM_KEY_CHECKING_ENABLED=false
NEXT_PUBLIC_INCLUDE_RIVE=false
NEXT_PUBLIC_MINIMUM_PRELOADER_DURATION=0.75

CMS_INCLUDE_DRAFTS=true

SANITY_API_DATASET=dataset
SANITY_API_TAG=default
SANITY_API_PROJECT_ID=r3hap4jk
SANITY_API_VERSION=v2023-08-01

# The base URL used to create the meta data URLs like og images
METADATA_BASE=https://puur-natuur-tuin.eu.dev.monkapps.com/website/

# When enabled it will download all the static assets coming from the graphql queries and store them in the build.
STATIC_ASSETS_ON_BUILD=true

# Some configuration for the downloading of the static assets
ASSET_CDN_BASE=https://cdn.sanity.io # The base URL for the assets coming from the CMS' CDN
ASSET_STATIC_BASE=/assets/public # The local version where to store the static assets, relative to the `out` folder.
TEMPORARY_STATIC_ASSETS_DIR=_temporary-static-assets # A temporary folder used to store the downloaded assets before moving them into the `out` folder

QUERY_CACHE_ENABLED=true

NEXT_PUBLIC_DEBUG_WEB_VITALS=true

DEBUG=frontend:*
